<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/orange</item>
        <item name="android:colorPrimaryDark">@color/orange_dark</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/orange_dark</item>
