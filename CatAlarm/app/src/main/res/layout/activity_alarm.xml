<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- Ambient backdrop: Oliver's photos, blurred, slowly cross-fading -->
    <FrameLayout
        android:id="@+id/slideA"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/slideABg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/slideAPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/slideB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <ImageView
            android:id="@+id/slideBBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/slideBPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_full" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:id="@+id/labelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_2"
            android:gravity="center"
            android:text="התראה"
            android:textAppearance="@style/TextAppearance.Oliver.Overline" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Oliver.Clock" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Oliver.Body"
            android:textColor="@color/text_secondary" />

        <!-- Avatar with pulsing rings -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/pulse1"
                android:layout_width="@dimen/avatar_ring"
                android:layout_height="@dimen/avatar_ring"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ring" />

            <View
                android:id="@+id/pulse2"
                android:layout_width="@dimen/avatar_ring"
                android:layout_height="@dimen/avatar_ring"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ring" />

            <View
                android:layout_width="@dimen/avatar_ring"
                android:layout_height="@dimen/avatar_ring"
                android:layout_gravity="center"
                android:background="@drawable/ring" />

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="@dimen/avatar"
                android:layout_height="@dimen/avatar"
                android:layout_gravity="center"
                android:contentDescription="אוליבר"
                android:scaleType="centerCrop"
                android:src="@drawable/cat_face" />
        </FrameLayout>

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_5"
            android:background="@drawable/pill_glass"
            android:drawablePadding="@dimen/space_2"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingVertical="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Oliver.BodySmall"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            style="@style/Oliver.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_tall"
            android:text="עצירה" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/snoozeButton"
            style="@style/Oliver.Button.Glass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_tall"
            android:layout_marginTop="@dimen/space_3" />
    </LinearLayout>
</FrameLayout>
