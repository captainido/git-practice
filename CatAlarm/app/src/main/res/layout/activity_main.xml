<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4">

            <!-- App bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_1">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OLIVER"
                        android:textAppearance="@style/TextAppearance.Oliver.Overline"
                        android:letterSpacing="0.3" />

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Oliver.Title" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="הגדרות"
                    android:src="@drawable/ic_more"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Next alarm hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                style="@style/Oliver.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:layout_marginTop="@dimen/space_2"
                app:cardCornerRadius="@dimen/radius_xl">

                <FrameLayout
                    android:id="@+id/slideA"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/slideABg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/slideAPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="אוליבר"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/slideB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0">

                    <ImageView
                        android:id="@+id/slideBBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/slideBPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/scrim_hero" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/space_6">

                    <TextView
                        android:id="@+id/nextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ההתראה הבאה"
                        android:textAppearance="@style/TextAppearance.Oliver.Overline" />

                    <TextView
                        android:id="@+id/nextTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.Oliver.Display" />

                    <TextView
                        android:id="@+id/nextDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.Oliver.Body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Setup needed -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/warningCard"
                style="@style/Oliver.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/danger_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4">

                    <ImageView
                        style="@style/Oliver.RowIcon"
                        android:src="@drawable/ic_info"
                        app:tint="@color/danger" />

                    <TextView
                        android:id="@+id/warningText"
                        style="@style/Oliver.RowText"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_3"
                android:text="התראות"
                android:textAppearance="@style/TextAppearance.Oliver.Headline" />

            <LinearLayout
                android:id="@+id/alarmList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_7"
                android:paddingBottom="@dimen/space_7"
                android:text="אין התראות עדיין.\nהקש על + כדי להוסיף."
                android:textAppearance="@style/TextAppearance.Oliver.BodySmall"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_6"
        android:contentDescription="הוספת התראה"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/gold"
        app:fabCustomSize="72dp"
        app:maxImageSize="32dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Oliver.Fab"
        app:tint="@color/on_gold" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
