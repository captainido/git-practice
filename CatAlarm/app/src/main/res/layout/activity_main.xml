<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/catFace"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cat_face" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/catQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="הוא יעיר אותך. בדרך שלו. 😼"
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="16dp"
                android:text="07:00"
                android:textColor="@color/ink"
                android:textSize="76sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לחץ על השעה כדי לשנות"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/enabledSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="המעורר פעיל"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/repeatCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="כל יום (החתול לא לוקח חופש)"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/permWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/warn"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_bg"
            android:text="🔊 תן לחתול להדגים עכשיו"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="טיפ: לטף את החתול בתמונה 🐾"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
