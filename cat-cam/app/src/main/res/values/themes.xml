<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CatCam" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/surface_high</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.CatCam.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="CatCam.StatLabel" parent="">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CatCam.StatValue" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>
