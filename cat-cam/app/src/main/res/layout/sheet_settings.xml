<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="הגדרות"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info"
        android:padding="12dp"
        android:text="הזיהוי מכויל לחתול שלך: גלאי חתולים מאתר אותו, מתקרב לבדוק שוב, ומשווה ל-9 תמונות שלו. חפצים דומים (כמו נעל בית אפורה) נפסלים."
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/intervalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/intervalSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:valueFrom="5"
        android:valueTo="120" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="כל עוד החתול בתמונה האפליקציה ממשיכה לצלם. הצליל מושמע פעם אחת כשהחתול מגיע."
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/soundSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="צליל בזיהוי"
        android:textSize="15sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/frontCameraSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="מצלמה קדמית"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/batteryButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="הגדרות סוללה (מומלץ: ללא הגבלה)" />
</LinearLayout>
